{
  "name": "vessel",
  "productName": "vessel",
  "version": "2.0.0",
  "description": "A simple wallet for managing your Hive accounts.",
  "main": "./out/main/main.dev.js",
  "author": "hive <none@hive.io>",
  "contributors": [
    {
      "name": "Hive",
      "email": "none@hive.io",
      "url": "https://hive.io"
    }
  ],
  "scripts": {
    "test": "jest",
    "test-all": "npm run lint && npm run test && npm run build",
    "test-watch": "jest --watch",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --format=node_modules/eslint-formatter-pretty .",
    "lint-fix": "npm run lint -- --fix",
    "lint-styles": "stylelint app/*.css app/components/*.css --syntax scss",
    "lint-styles-fix": "stylefmt -r app/*.css app/components/*.css",
    "hot-updates-server": "cross-env NODE_ENV=development webpack serve --config webpack.config.renderer.dev.js",
    "build": "concurrently \"npm run build-main\" \"npm run build-renderer\"",
    "build-dll": "cross-env NODE_ENV=development webpack --config webpack.config.renderer.dev.dll.js --progress --color",
    "build-main": "cross-env NODE_ENV=production webpack --config webpack.config.main.prod.js --progress --color",
    "build-renderer": "cross-env NODE_ENV=production webpack --config webpack.config.renderer.prod.js --progress --color",
    "start": "cross-env NODE_ENV=production DEBUG_PROD=true electron ./app/",
    "prestart": "npm run build",
    "build-main-dev": "cross-env NODE_ENV=development webpack --config webpack.config.main.prod.js",
    "start-hot-renderer": "npm run build-main-dev && cross-env HOT=1 NODE_ENV=development electron ./app/main.prod.js",
    "postinstall": "concurrently \"npm run build-dll\" \"electron-builder install-app-deps\"",
    "dev": "cross-env NODE_ENV=development START_HOT=1 npm run hot-updates-server",
    "package": "npm run build && electron-builder --publish never",
    "package-win": "npm run build && electron-builder --win --x64",
    "package-linux": "npm run build && electron-builder --linux",
    "package-all": "npm run build && electron-builder -mwl",
    "release": "electron-builder -mwl",
    "dist": "electron-builder -mw",
    "typecheck": "tsc --noEmit",
    "dev:vite": "electron-vite dev",
    "build:vite": "electron-vite build",
    "preview:vite": "electron-vite preview"
  },
  "browserslist": "chrome 120",
  "build": {
    "productName": "Vessel",
    "appId": "com.greymass.vessel",
    "files": [
      "dist/",
      "node_modules/",
      "app.html",
      "main.prod.js",
      "main.prod.js.map",
      "preload.js",
      "package.json"
    ],
    "protocols": [
      {
        "name": "hive",
        "role": "Viewer",
        "schemes": [
          "hive",
          "vessel"
        ]
      }
    ],
    "dmg": {
      "icon": "assets/icons/mac/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "icon": "assets/icons/mac/icon.icns"
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Network",
      "desktop": {
        "Name": "vessel",
        "Version": "1.0.3",
        "GenericName": "Hive Client",
        "X-GNOME-FullName": "vessel",
        "Comment": "A simple wallet for managing your Hive accounts.",
        "Type": "Application",
        "Terminal": "false",
        "StartupNotify": "false",
        "Categories": "Network;",
        "MimeType": "application/x-hive;x-scheme-handler/hive;"
      },
      "icon": "assets/icons/png",
      "target": [
        "deb"
      ]
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.syncad.com/hive/vessel"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.syncad.com/hive/vessel/issues"
  },
  "keywords": [
    "hive",
    "blockchain",
    "wallet"
  ],
  "homepage": "https://gitlab.syncad.com/hive/vessel/vessel",
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/internals/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleDirectories": [
      "node_modules",
      "app/node_modules"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|@noble)/)"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.2.0",
    "asar": "^0.13.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-dev-expression": "^0.2.3",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "buffer": "^6.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.36.0",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.0",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-pretty": "^3.0.1",
    "eslint-import-resolver-webpack": "^0.13.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^23.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "express": "^4.17.1",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jsdom": "^10.1.0",
    "mini-css-extract-plugin": "^2.8.0",
    "minimist": "^1.2.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.2.0",
    "redux-logger": "^3.0.6",
    "rimraf": "^5.0.5",
    "sass": "^1.70.0",
    "sass-loader": "^14.1.0",
    "sinon": "^2.4.1",
    "stream-browserify": "^3.0.0",
    "style-loader": "^3.3.4",
    "stylefmt": "^5.3.2",
    "stylelint": "^7.13.0",
    "stylelint-config-standard": "^16.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "webpack": "^5.90.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@hiveio/hive-js": "^2.0.4",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^2.2.0",
    "electron-debug": "^3.2.0",
    "electron-json-storage": "^4.6.0",
    "electron-log": "^5.1.0",
    "fomantic-ui-css": "^2.9.3",
    "font-awesome": "^4.7.0",
    "formsy-react": "^2.3.0",
    "formsy-semantic-ui-react": "^1.0.1",
    "history": "^5.3.0",
    "react": "^18.2.0",
    "react-autocomplete": "^1.8.1",
    "react-collapsible": "^2.10.0",
    "react-dom": "^18.2.0",
    "react-input-range": "^1.3.0",
    "react-intl": "^6.6.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.22.0",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.2",
    "semantic-ui-react": "^2.1.5",
    "source-map-support": "^0.5.21",
    "url-parse": "^1.5.10"
  },
  "overrides": {
    "formsy-semantic-ui-react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-autocomplete": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-input-range": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
