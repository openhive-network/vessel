{
  "name": "vessel",
  "productName": "vessel",
  "desktopName": "vessel.desktop",
  "version": "3.0.0",
  "description": "A simple wallet for managing your Hive accounts.",
  "main": "./out/main/main.dev.js",
  "author": "hive <none@hive.io>",
  "contributors": [
    {
      "name": "Hive",
      "email": "none@hive.io",
      "url": "https://hive.io"
    }
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "cross-env NODE_ENV=production electron ./out/main/main.dev.js",
    "prestart": "pnpm run build",
    "test": "vitest run",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
    "test-watch": "vitest",
    "test-e2e": "playwright test",
    "test-all": "pnpm run lint && pnpm run test && pnpm run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "pnpm run lint --fix",
    "package": "pnpm run build && electron-builder --publish never",
    "package-win": "pnpm run build && electron-builder --win --x64",
    "package-linux": "pnpm run build && electron-builder --linux",
    "package-all": "pnpm run build && electron-builder -mwl",
    "release": "electron-builder -mwl",
    "dist": "electron-builder -mw",
    "postinstall": "electron-builder install-app-deps"
  },
  "browserslist": "chrome 120",
  "build": {
    "productName": "Vessel",
    "appId": "com.greymass.vessel",
    "beforePack": "build/signingNotice.js",
    "afterPack": "build/afterPackIcon.js",
    "forceCodeSigning": false,
    "files": [
      "out/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/main.dev.js"
    },
    "protocols": [
      {
        "name": "hive",
        "role": "Viewer",
        "schemes": [
          "hive",
          "vessel"
        ]
      }
    ],
    "dmg": {
      "icon": "assets/icons/mac/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "icon": "assets/icons/mac/icon.icns",
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "linux": {
      "category": "Network",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "vessel",
          "GenericName": "Hive Client",
          "Comment": "A simple wallet for managing your Hive accounts.",
          "Categories": "Network;",
          "MimeType": "application/x-hive;x-scheme-handler/hive;x-scheme-handler/vessel;"
        }
      },
      "icon": "assets/icons/png",
      "target": [
        "deb"
      ]
    },
    "directories": {
      "app": ".",
      "buildResources": "resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.syncad.com/hive/vessel"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.syncad.com/hive/vessel/issues"
  },
  "keywords": [
    "hive",
    "blockchain",
    "wallet"
  ],
  "homepage": "https://gitlab.syncad.com/hive/vessel",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "catalog:playwright-toolset",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24",
    "@types/react": "catalog:react-toolset",
    "@types/react-dom": "catalog:react-toolset",
    "@vitejs/plugin-react": "^5.2.0",
    "@hiveio/hive-js": "^2.0.4",
    "@types/bluebird": "^3.5.42",
    "bluebird": "^3.7.2",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-extension-installer": "^2.0.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "redux-logger": "^3.0.6",
    "sass": "^1.70.0",
    "typescript": "catalog:typescript-toolset",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@scure/bip39": "^2.2.0",
    "@tabler/icons-react": "^3.46.0",
    "electron-debug": "^3.2.0",
    "hive-tx": "^7.2.0",
    "lodash": "^4.17.21",
    "react": "catalog:react-toolset",
    "react-dom": "catalog:react-toolset",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "source-map-support": "^0.5.21"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
