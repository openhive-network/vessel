{
  "name": "vessel",
  "productName": "vessel",
  "version": "2.0.0",
  "description": "A simple wallet for managing your Hive accounts.",
  "main": "./out/main/main.dev.js",
  "author": "hive <none@hive.io>",
  "contributors": [
    {
      "name": "Hive",
      "email": "none@hive.io",
      "url": "https://hive.io"
    }
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "cross-env NODE_ENV=production electron ./out/main/main.dev.js",
    "prestart": "npm run build",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-e2e": "playwright test",
    "test-all": "npm run lint && npm run test && npm run build",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "npm run lint -- --fix",
    "package": "npm run build && electron-builder --publish never",
    "package-win": "npm run build && electron-builder --win --x64",
    "package-linux": "npm run build && electron-builder --linux",
    "package-all": "npm run build && electron-builder -mwl",
    "release": "electron-builder -mwl",
    "dist": "electron-builder -mw",
    "postinstall": "electron-builder install-app-deps",
    "dev:vite": "electron-vite dev",
    "build:vite": "electron-vite build",
    "preview:vite": "electron-vite preview"
  },
  "browserslist": "chrome 120",
  "build": {
    "productName": "Vessel",
    "appId": "com.greymass.vessel",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/main.dev.js"
    },
    "protocols": [
      {
        "name": "hive",
        "role": "Viewer",
        "schemes": [
          "hive",
          "vessel"
        ]
      }
    ],
    "dmg": {
      "icon": "assets/icons/mac/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "icon": "assets/icons/mac/icon.icns"
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Network",
      "desktop": {
        "entry": {
          "Name": "vessel",
          "GenericName": "Hive Client",
          "Comment": "A simple wallet for managing your Hive accounts.",
          "Categories": "Network;",
          "MimeType": "application/x-hive;x-scheme-handler/hive;"
        }
      },
      "icon": "assets/icons/png",
      "target": [
        "deb"
      ]
    },
    "directories": {
      "app": ".",
      "buildResources": "resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.syncad.com/hive/vessel"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.syncad.com/hive/vessel/issues"
  },
  "keywords": [
    "hive",
    "blockchain",
    "wallet"
  ],
  "homepage": "https://gitlab.syncad.com/hive/vessel/vessel",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "asar": "^0.13.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "buffer": "^6.0.3",
    "chalk": "^4.1.2",
    "core-js": "^3.36.0",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^10.1.0",
    "minimist": "^1.2.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.2.0",
    "redux-logger": "^3.0.6",
    "rimraf": "^5.0.5",
    "sass": "^1.70.0",
    "sinon": "^2.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@hiveio/hive-js": "^2.0.4",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^2.2.0",
    "electron-debug": "^3.2.0",
    "electron-json-storage": "^4.6.0",
    "electron-log": "^5.1.0",
    "fomantic-ui-css": "^2.9.3",
    "font-awesome": "^4.7.0",
    "formsy-react": "^2.3.0",
    "formsy-semantic-ui-react": "^1.0.1",
    "history": "^5.3.0",
    "react": "^18.2.0",
    "react-autocomplete": "^1.8.1",
    "react-collapsible": "^2.10.0",
    "react-dom": "^18.2.0",
    "react-input-range": "^1.3.0",
    "react-intl": "^6.6.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.22.0",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.2",
    "semantic-ui-react": "^2.1.5",
    "source-map-support": "^0.5.21",
    "url-parse": "^1.5.10"
  },
  "overrides": {
    "formsy-semantic-ui-react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-autocomplete": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-input-range": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
